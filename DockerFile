# Estágio de construção
FROM maven:3.8.6-openjdk-17 AS build
WORKDIR /app

# Copiar arquivos do projeto
COPY pom.xml .
COPY src ./src

# Construir o projeto
RUN mvn clean package -DskipTests

# Estágio de execução
FROM openjdk:17-jdk-slim
WORKDIR /app

# Copiar o artefato construído
COPY --from=build /app/target/caps-0.0.1-SNAPSHOT.jar app.jar

# Definir variáveis de ambiente (pode ser sobrescrito no docker run)
ENV SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/CAPS
ENV SPRING_DATASOURCE_USERNAME=root
ENV SPRING_DATASOURCE_PASSWORD=1234
ENV JWT_SECRET=my-secret-key

# Expor a porta padrão do Spring Boot
EXPOSE 8080

# Comando para executar a aplicação
ENTRYPOINT ["java", "-jar", "app.jar"]