<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
    http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="raas" pageWidth="595" pageHeight="842" columnWidth="555"
    leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- ================= PARAMETROS ================= -->
    <parameter name="nomeEstabelecimento" class="java.lang.String"/>
    <parameter name="cnes" class="java.lang.String"/>
    <parameter name="nomePaciente" class="java.lang.String"/>
    <parameter name="cartaoSus" class="java.lang.Long"/>
    <parameter name="dataNascimento" class="java.lang.String"/>
    <parameter name="nomeMae" class="java.lang.String"/>
    <parameter name="dataAdmissao" class="java.time.LocalDate"/>
    <parameter name="dataConclusao" class="java.time.LocalDate"/>
    <parameter name="mesAtendimento" class="java.lang.String"/>
    <parameter name="numeroAutorizacao" class="java.lang.Long"/>

    <parameter name="acoesDataset" class="net.sf.jasperreports.engine.data.JRBeanCollectionDataSource"/>

    <!-- ================= TITULO ================= -->
    <title>
        <band height="60">
            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[MINISTÉRIO DA SAÚDE]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="20" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[RAAS - REGISTRO DAS AÇÕES AMBULATORIAIS]]></text>
            </staticText>
        </band>
    </title>

    <!-- ================= DETALHE ================= -->
    <detail>
        <band height="400">

            <!-- ESTABELECIMENTO -->
            <staticText>
                <reportElement x="0" y="0" width="300" height="15"/>
                <text><![CDATA[NOME ESTABELECIMENTO]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="15" width="300" height="15"/>
                <textFieldExpression><![CDATA[$P{nomeEstabelecimento}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="310" y="0" width="100" height="15"/>
                <text><![CDATA[CNES]]></text>
            </staticText>

            <textField>
                <reportElement x="310" y="15" width="100" height="15"/>
                <textFieldExpression><![CDATA[$P{cnes}]]></textFieldExpression>
            </textField>

            <!-- PACIENTE -->
            <staticText>
                <reportElement x="0" y="40" width="300" height="15"/>
                <text><![CDATA[NOME PACIENTE]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="55" width="300" height="15"/>
                <textFieldExpression><![CDATA[$P{nomePaciente}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="75" width="200" height="15"/>
                <text><![CDATA[CARTÃO SUS]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="90" width="200" height="15"/>
                <textFieldExpression><![CDATA[$P{cartaoSus}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="210" y="75" width="200" height="15"/>
                <text><![CDATA[DATA NASCIMENTO]]></text>
            </staticText>

            <textField>
                <reportElement x="210" y="90" width="200" height="15"/>
                <textFieldExpression><![CDATA[$P{dataNascimento}]]></textFieldExpression>
            </textField>

            <!-- ATENDIMENTO -->
            <staticText>
                <reportElement x="0" y="120" width="150" height="15"/>
                <text><![CDATA[DATA ADMISSÃO]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="135" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{dataAdmissao}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="160" y="120" width="150" height="15"/>
                <text><![CDATA[MÊS ATENDIMENTO]]></text>
            </staticText>

            <textField>
                <reportElement x="160" y="135" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{mesAtendimento}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="320" y="120" width="150" height="15"/>
                <text><![CDATA[Nº AUTORIZAÇÃO]]></text>
            </staticText>

            <textField>
                <reportElement x="320" y="135" width="150" height="15"/>
                <textFieldExpression><![CDATA[$P{numeroAutorizacao}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <!-- ================= AÇÕES ================= -->
    <detail>
        <band height="20">
            <subreport>
                <reportElement x="0" y="0" width="555" height="20"/>
                <dataSourceExpression><![CDATA[$P{acoesDataset}]]></dataSourceExpression>
                <subreportExpression><![CDATA["subreport_acoes.jasper"]]></subreportExpression>
            </subreport>
        </band>
    </detail>

</jasperReport>