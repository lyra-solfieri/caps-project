                                <textElement><font size="7"/></textElement>
                                <textFieldExpression><![CDATA[$F{codigoAcao}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="35">
                        <jr:columnHeader height="16">
                            <staticText>
                                <reportElement x="0" y="0" width="35" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement textAlignment="Center"><font size="7" isBold="true"/></textElement>
                                <text><![CDATA[QTD]]></text>
