            <textField isBlankWhenNull="true">
                <reportElement x="0" y="90" width="160" height="15"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{cartaoSus}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="170" y="75" width="110" height="15"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[DATA DE NASCIMENTO]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="170" y="90" width="110" height="15"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{dataNascimento}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="290" y="75" width="110" height="15"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[SEXO]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="290" y="90" width="110" height="15"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{sexo}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="110" width="400" height="15"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[NOME DA MÃE]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="125" width="400" height="15"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{nomeMae}]]></textFieldExpression>
            </textField>

            <!-- ATENDIMENTO -->
            <staticText>
                <reportElement x="0" y="145" width="130" height="15"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[DATA DE ADMISSÃO]]></text>
            </staticText>
