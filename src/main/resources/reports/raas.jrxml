                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[DATA DE CONCLUSÃO]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="140" y="160" width="130" height="15"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{dataConclusao}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="280" y="145" width="120" height="15"/>
                <textElement><font size="7" isBold="true"/></textElement>
                <text><![CDATA[MÊS DE ATENDIMENTO]]></text>
