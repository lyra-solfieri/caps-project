                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{numeroAutorizacao}]]></textFieldExpression>
            </textField>

            <!-- ACOES -->
            <staticText>
                <reportElement x="0" y="185" width="555" height="15"/>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[AÇÕES REGISTRADAS]]></text>
            </staticText>

            <componentElement>
                <reportElement x="0" y="200" width="555" height="80"/>
                <jr:table>
                    <datasetRun subDataset="acoes">
                        <dataSourceExpression><![CDATA[$P{acoesDataset}]]></dataSourceExpression>
