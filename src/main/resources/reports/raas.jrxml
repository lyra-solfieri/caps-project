                                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="60">
                        <jr:columnHeader height="16">
                            <staticText>
                                <reportElement x="0" y="0" width="60" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement><font size="7" isBold="true"/></textElement>
