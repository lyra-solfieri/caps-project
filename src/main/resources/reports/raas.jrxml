                    <jr:column width="45">
                        <jr:columnHeader height="16">
                            <staticText>
                                <reportElement x="0" y="0" width="45" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement><font size="7" isBold="true"/></textElement>
                                <text><![CDATA[CBO EXEC.]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="16">
                            <textField isBlankWhenNull="true">
                                <reportElement x="0" y="0" width="45" height="16"/>
