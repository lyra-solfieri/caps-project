                                <box><pen lineWidth="0.5"/></box>
                                <textElement><font size="7"/></textElement>
                                <textFieldExpression><![CDATA[$F{data} != null ? $F{data}.format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy")) : ""]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="50">
                        <jr:columnHeader height="16">
                            <staticText>
                                <reportElement x="0" y="0" width="50" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement><font size="7" isBold="true"/></textElement>
                                <text><![CDATA[CID-10]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="16">
                            <textField isBlankWhenNull="true">
                                <reportElement x="0" y="0" width="50" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
                                <textElement><font size="7"/></textElement>
                                <textFieldExpression><![CDATA[$F{cid10}]]></textFieldExpression>
                            </textField>
