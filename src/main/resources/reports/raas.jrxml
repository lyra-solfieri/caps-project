                                <textElement><font size="7"/></textElement>
                                <textFieldExpression><![CDATA[$F{servico}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="55">
                        <jr:columnHeader height="16">
                            <staticText>
                                <reportElement x="0" y="0" width="55" height="16"/>
                                <box><pen lineWidth="0.5"/></box>
