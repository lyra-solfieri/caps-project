<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:jr="http://jasperreports.sourceforge.net/jasperreports/components"
    xsi:schemaLocation="
        http://jasperreports.sourceforge.net/jasperreports
        http://jasperreports.sourceforge.net/xsd/jasperreport.xsd
        http://jasperreports.sourceforge.net/jasperreports/components
        http://jasperreports.sourceforge.net/xsd/components.xsd"
    name="raas"
    pageWidth="595" pageHeight="842"
    columnWidth="555"
    leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <parameter name="nomeEstabelecimento" class="java.lang.String"/>
    <parameter name="cnes" class="java.lang.String"/>

    <parameter name="nomePaciente" class="java.lang.String"/>
    <parameter name="cartaoSus" class="java.lang.Long"/>
    <parameter name="dataNascimento" class="java.lang.String"/>
    <parameter name="nomeMae" class="java.lang.String"/>

    <parameter name="dataAdmissao" class="java.time.LocalDate"/>
    <parameter name="dataConclusao" class="java.time.LocalDate"/>
    <parameter name="mesAtendimento" class="java.lang.String"/>
    <parameter name="numeroAutorizacao" class="java.lang.Long"/>

    <parameter name="acoesDataset" class="net.sf.jasperreports.engine.JRDataSource"/>

    <!-- ========================= -->
    <!-- DATASET AÇÕES -->
    <!-- ========================= -->
    <subDataset name="acoesDataset">
        <field name="codigoAcao" class="java.lang.String"/>
        <field name="quantidade" class="java.lang.Integer"/>
        <field name="data" class="java.time.LocalDate"/>
        <field name="servico" class="java.lang.String"/>
        <field name="classificacao" class="java.lang.String"/>
        <field name="cboExecutor" class="java.lang.String"/>
        <field name="cartaoProfissional" class="java.lang.String"/>
    </subDataset>

    <!-- ========================= -->
    <!-- TITLE -->
    <!-- ========================= -->
    <title>
        <band height="80">

            <staticText>
                <reportElement x="0" y="0" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[MINISTÉRIO DA SAÚDE]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="20" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[RAAS - REGISTRO DAS AÇÕES AMBULATORIAIS ESPECIALIZADAS]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[(PSICOSSOCIAL E ATENÇÃO ESPECIALIZADA)]]></text>
            </staticText>

        </band>
    </title>

    <!-- ========================= -->
    <!-- DETAIL -->
    <!-- ========================= -->
    <detail>
        <band height="600">

            <!-- ESTABELECIMENTO -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="15"/>
                <text><![CDATA[IDENTIFICAÇÃO DO ESTABELECIMENTO DE SAÚDE]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="20" width="400" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{nomeEstabelecimento}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="20" width="155" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{cnes}]]></textFieldExpression>
            </textField>

            <!-- PACIENTE -->
            <staticText>
                <reportElement x="0" y="60" width="555" height="15"/>
                <text><![CDATA[IDENTIFICAÇÃO DO USUÁRIO SUS]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="80" width="300" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{nomePaciente}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="300" y="80" width="255" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{cartaoSus}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="110" width="200" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{dataNascimento}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="200" y="110" width="355" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{nomeMae}]]></textFieldExpression>
            </textField>

            <!-- ATENDIMENTO -->
            <staticText>
                <reportElement x="0" y="150" width="555" height="15"/>
                <text><![CDATA[DADOS DO ATENDIMENTO]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="170" width="150" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{mesAtendimento}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="150" y="170" width="200" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textFieldExpression><![CDATA[$P{numeroAutorizacao}]]></textFieldExpression>
            </textField>

            <!-- AÇÕES -->
            <staticText>
                <reportElement x="0" y="210" width="555" height="15"/>
                <text><![CDATA[AÇÕES REALIZADAS]]></text>
            </staticText>

            <componentElement>
                <reportElement x="0" y="230" width="555" height="200"/>
                <jr:table>

                    <datasetRun subDataset="acoesDataset">
                        <dataSourceExpression><![CDATA[$P{acoesDataset}]]></dataSourceExpression>
                    </datasetRun>

                    <jr:column width="100">
                        <jr:columnHeader height="20">
                            <staticText>
                                <reportElement width="100" height="20"/>
                                <text><![CDATA[Código]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="20">
                            <textField>
                                <textFieldExpression><![CDATA[$F{codigoAcao}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="50">
                        <jr:columnHeader height="20">
                            <staticText>
                                <reportElement width="50" height="20"/>
                                <text><![CDATA[Qtd]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="20">
                            <textField>
                                <textFieldExpression><![CDATA[$F{quantidade}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="80">
                        <jr:columnHeader height="20">
                            <staticText>
                                <reportElement width="80" height="20"/>
                                <text><![CDATA[Data]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="20">
                            <textField>
                                <textFieldExpression><![CDATA[$F{data}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="120">
                        <jr:columnHeader height="20">
                            <staticText>
                                <reportElement width="120" height="20"/>
                                <text><![CDATA[Serviço]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="20">
                            <textField>
                                <textFieldExpression><![CDATA[$F{servico}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                    <jr:column width="205">
                        <jr:columnHeader height="20">
                            <staticText>
                                <reportElement width="205" height="20"/>
                                <text><![CDATA[Classificação]]></text>
                            </staticText>
                        </jr:columnHeader>
                        <jr:detailCell height="20">
                            <textField>
                                <textFieldExpression><![CDATA[$F{classificacao}]]></textFieldExpression>
                            </textField>
                        </jr:detailCell>
                    </jr:column>

                </jr:table>
            </componentElement>

        </band>
    </detail>

</jasperReport>